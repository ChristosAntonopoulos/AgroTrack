{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "OliveLifecycle"
  },
  "JWT": {
    "SecretKey": "",
    "Issuer": "OliveLifecycleAPI",
    "Audience": "OliveLifecycleClients",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedHost": ""
  },
  "Storage": {
    "LocalPath": "uploads",
    "PublicBasePath": "/uploads"
  },
  "Auth": {
    "AllowAnonymous": false
  },
  "Geospatial": {
    "Weather": {
      "Provider": "OpenMeteo",
      "BaseUrl": "https://api.open-meteo.com/v1",
      "ApiKey": "",
      "RefreshMinutes": 60,
      "GridRoundingDecimals": 2
    },
    "Satellite": {
      "StacBaseUrl": "https://earth-search.aws.element84.com/v1",
      "Collection": "sentinel-2-l2a",
      "MaxCloudCover": 20,
      "DiscoveryIntervalHours": 24,
      "SearchWindowDays": 30,
      "AnalysisPixelSizeMetres": 10,
      "MaxRasterDimension": 2048,
      "MinUsablePixelPercent": 40,
      "ReflectanceScale": 10000,
      "ReflectanceOffset": -1000,
      "RetentionDays": 400,
      "GenerateOverlays": true
    },
    "Terrain": {
      "DemSource": "CopernicusGlo30",
      "FallbackDem": "Glo90"
    },
    "Fires": {
      "FirmsBaseUrl": "https://firms.modaps.eosdis.nasa.gov/api/country/csv",
      "MapKey": "",
      "RefreshMinutes": 120,
      "SearchRadiusKm": 50,
      "CountryCode": "GRC"
    },
    "Map": {
      "BaseMapProvider": "OpenFreeMap",
      "StyleUrl": "https://tiles.openfreemap.org/styles/liberty",
      "SatelliteTileUrl": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
      "StreetTileUrl": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
      "CadastreLayerEnabled": false
    },
    "Storage": {
      "RasterRoot": "geospatial"
    },
    "Jobs": {
      "Enabled": true,
      "WeatherRefreshMinutes": 60,
      "FireRefreshMinutes": 120,
      "SnapshotHourUtc": 0
    },
    "SlopeClassification": {
      "FlatMaxPercent": 5,
      "ModerateMaxPercent": 12,
      "SteepMaxPercent": 20
    },
    "FrostRisk": {
      "LowTempC": 4,
      "ModerateTempC": 2,
      "HighTempC": 1,
      "CriticalTempC": 0
    },
    "TaskRules": {
      "SprayingMaxWindKmh": 20,
      "SprayingMaxGustKmh": 30,
      "SprayingMinHumidityPercent": 40,
      "SprayingMaxHumidityPercent": 90,
      "IrrigationRainThresholdMm": 5,
      "HarvestMaxWindKmh": 35,
      "HeatStressTempC": 35
    }
  }
}
