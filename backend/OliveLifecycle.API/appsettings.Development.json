  },
  "Email": {
    "ExposeDevResetLink": true
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://127.0.0.1:3000" ]
  },

  "DemoAccounts": {
    "Seed": true,
    "ReseedFarmData": true
  }

