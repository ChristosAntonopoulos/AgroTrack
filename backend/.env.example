# Backend environment variables (production/staging)
# Copy to your deployment configuration or user secrets.

JWT__SecretKey=your-production-secret-at-least-32-characters
MongoDB__ConnectionString=mongodb://localhost:27017
MongoDB__DatabaseName=OliveLifecycle

# Optional NASA FIRMS map key. Without it, fire detections stay disabled.
Geospatial__Fires__MapKey=

# Raster files are stored under Storage:LocalPath / Geospatial:Storage:RasterRoot
Storage__LocalPath=uploads
Geospatial__Storage__RasterRoot=geospatial
Geospatial__Jobs__Enabled=true
