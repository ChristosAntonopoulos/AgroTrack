{
  "expo": {
    "name": "TheOliveLot",
    "slug": "olive-lifecycle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "theolivelot",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F0E6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theolivelot.app",
      "associatedDomains": [
        "applinks:theolivelot.com",
        "applinks:www.theolivelot.com"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "The Olive Lot uses your location only when you choose Use my location to place a field on the map.",
        "NSPhotoLibraryUsageDescription": "The Olive Lot looks through your photos for shots taken on your fields so they can appear in Photo Hub and Chronologio. Nothing is uploaded until you confirm.",
        "NSPhotoLibraryAddUsageDescription": "The Olive Lot may save photos you take for field records."
      }
    },
    "android": {
      "package": "com.theolivelot.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F0E6"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "theolivelot.com",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "theolivelot.com",
              "pathPrefix": "/family-invite"
            },
            {
              "scheme": "https",
              "host": "theolivelot.com",
              "pathPrefix": "/partner-invite"
            },
            {
              "scheme": "https",
              "host": "www.theolivelot.com",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "www.theolivelot.com",
              "pathPrefix": "/family-invite"
            },
            {
              "scheme": "https",
              "host": "www.theolivelot.com",
              "pathPrefix": "/partner-invite"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "The Olive Lot uses your location only when you choose Use my location to place a field on the map.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1F2820",
          "sounds": []
        }
      ],
        [
        "expo-image-picker",
        {
          "photosPermission": "Allow The Olive Lot to access your photos for task evidence and field Photo Hub.",
          "cameraPermission": "Allow The Olive Lot to use your camera for task evidence."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "The Olive Lot looks for photos taken on or near your fields so they can appear in Photo Hub and Chronologio by capture date.",
          "savePhotosPermission": "Allow The Olive Lot to save photos you take for field records.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-document-picker",
      "expo-contacts",
      "expo-localization",
      "expo-font",
      "expo-dev-client",
      "@maplibre/maplibre-react-native",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "be78596e-4800-4b0c-b4c6-8da986423352"
      }
    },
    "owner": "botsyst3m"
  }
}
