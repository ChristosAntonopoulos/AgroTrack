{
  "expo": {
    "name": "AgroTrack",
    "slug": "olive-lifecycle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#63622a"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to show field locations on the map and provide weather information.",
        "NSLocationAlwaysUsageDescription": "This app needs access to your location to show field locations on the map and provide weather information."
      }
    },
    "android": {
      "package": "com.agrotrack.olivelifecycle",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#63622a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY_HERE"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Olive Lifecycle to use your location to show field locations and weather information."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#63622a",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AgroTrack to access your photos for task evidence.",
          "cameraPermission": "Allow AgroTrack to use your camera for task evidence."
        }
      ],
      "expo-localization",
      "expo-font"
    ],
    "extra": {
      "googleMapsApiKey": "YOUR_GOOGLE_MAPS_API_KEY_HERE",
      "eas": {
        "projectId": "be78596e-4800-4b0c-b4c6-8da986423352"
      }
    },
    "owner": "botsyst3m"
  }
}
