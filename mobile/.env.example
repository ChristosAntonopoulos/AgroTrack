# Mock data: set to "true" for offline development without the backend.
EXPO_PUBLIC_USE_MOCK_DATA=false

# API origin (optional).
# Development default: http://localhost:5149 (iOS sim) or http://10.0.2.2:5149 (Android emulator).
# Production APK (EAS/pipeline): http://185.193.66.50:31247 — baked in at build time.
#
# Physical device on same Wi‑Fi (backend must listen on 0.0.0.0:5149):
# EXPO_PUBLIC_API_URL=http://192.168.1.43:5149
#
# Physical Android + USB debugging:
#   adb reverse tcp:5149 tcp:5149
# then leave EXPO_PUBLIC_API_URL unset (uses localhost via reverse).
