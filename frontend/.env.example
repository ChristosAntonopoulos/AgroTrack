# Real API mode (recommended when backend is running locally)
REACT_APP_USE_MOCK_DATA=false
REACT_APP_DISABLE_AUTH=false
REACT_APP_SHOW_DEMO_LOGIN=false
# Leave empty in dev to use CRA proxy (setupProxy.js → http://localhost:5149)
REACT_APP_API_URL=

# Demo mode — no backend required
# REACT_APP_USE_MOCK_DATA=true
# REACT_APP_SHOW_DEMO_LOGIN=true

# Direct API URL (staging/production)
# REACT_APP_API_URL=https://your-api.example.com

# Skip login entirely (requires backend Auth:AllowAnonymous=true — dev only)
# REACT_APP_DISABLE_AUTH=true

# --- Subscriptions (RevenueCat Web Billing) ---
# Public SDK key only (Web Billing or Test Store). Never put secret keys here.
# Leave empty to disable web checkout (paywall shows a calm 'not available' state).
REACT_APP_REVENUECAT_WEB_API_KEY=
# Entitlement id; must match backend Subscription:ProEntitlementId
REACT_APP_REVENUECAT_ENTITLEMENT_ID=pro
# Optional: force a specific offering id instead of the dashboard 'current' offering
REACT_APP_REVENUECAT_OFFERING_ID=
